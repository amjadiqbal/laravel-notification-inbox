includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Namespaced package view (notification-inbox::inbox), registered in the service provider; Larastan only knows app views.
        - identifier: argument.type
          path: src/Http/Controllers/InboxController.php
          message: '#view-string#'
