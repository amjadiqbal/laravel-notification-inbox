{
    "name": "amjadiqbal/laravel-notification-inbox",
    "description": "Catch every non-mail Laravel notification in local and staging instead of sending it: web push, FCM, APNs, Expo, Slack, Microsoft Teams, Telegram, Discord, Twilio and Vonage SMS, and broadcast. Realistic previews in one inbox, plus test assertions on the real payloads.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amjadiqbal",
        "laravel",
        "laravel-package",
        "notifications",
        "laravel-notifications",
        "notification-channels",
        "notification-catcher",
        "push-notifications",
        "web-push",
        "fcm",
        "slack",
        "microsoft-teams",
        "telegram",
        "discord",
        "sms",
        "testing"
    ],
    "homepage": "https://amjad.com.pk/laravel/packages/laravel-notification-inbox",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-notification-inbox/issues",
        "source": "https://github.com/amjadiqbal/laravel-notification-inbox",
        "docs": "https://amjad.com.pk/laravel/packages/laravel-notification-inbox"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\NotificationInbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\NotificationInbox\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/Notifications.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\NotificationInbox\\NotificationInboxServiceProvider"
            ],
            "aliases": {
                "NotificationInbox": "AmjadIqbal\\NotificationInbox\\Facades\\NotificationInbox"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
